# Anthropic (Claude Agent SDK)
ANTHROPIC_API_KEY=

# TypeSafe / Jev
TYPESAFE_API_KEY=

# Google Sheets service account — provide ONE of the two below
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Fallback only — used when an upload request doesn't include its own Drive
# folder + OAuth token (i.e. the user didn't click "Select Google Drive folder").
# The spreadsheet created once and shared with the service account + both spouses.
GOOGLE_SHEET_ID=

# Shared secret the web app must send as the x-api-key header
BACKEND_API_KEY=

PORT=8080
